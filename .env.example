LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Choose a model you have pulled locally and that supports tool calling. Granite is a good starting point.
OLLAMA_MODEL=granite3.3:8b
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/ecommerce_db
OWNER_DATABASE_URL=postgresql+psycopg://YOUR_OWNER_USER:YOUR_OWNER_PASSWORD@localhost:5432/ecommerce_db
APP_MAX_WEB_BYTES=1500000
APP_MAX_WEB_CHARS=18000
APP_HTTP_TIMEOUT=12
APP_SQL_TIMEOUT_MS=5000
APP_SQL_MAX_ROWS=100
APP_LOG_LEVEL=INFO
